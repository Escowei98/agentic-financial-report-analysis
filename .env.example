# Google Cloud Vertex AI (auth via: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west1

COHERE_API_KEY=your-cohere-api-key-here

# OpenAI (used only as the evaluation judge model — deliberately a
# different provider than the Gemini models under test)
OPENAI_API_KEY=your-openai-api-key-here

# SEC EDGAR requires identification (name + email)
SEC_EDGAR_EMAIL=your.email@example.com
